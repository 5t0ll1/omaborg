#!/usr/bin/env bash
# Exit 0 when the repository host answers, so Vorta only starts a backup it
# can actually finish. Point Vorta's pre-backup command at it:
#
#   vorta-require-repo HOST [PORT]
#   vorta-require-repo my-nas.example.lan 6666
#
# A plain TCP connect is deliberately enough: this only decides whether
# starting is worthwhile. If the machine answering is not the expected one,
# SSH rejects it seconds later on its own host key check.
#
# It covers being at home, being away with any VPN up, and being away without
# one - it asks about reachability, not about location. Two earlier approaches
# did not: `tailscale ping` tied the check to one specific VPN and blocked
# every backup once that VPN was shut down, and a Wi-Fi SSID comparison cannot
# tell apart two places that broadcast the same network name.
set -uo pipefail

host="${1:-}"
port="${2:-22}"

if [[ -z $host ]]; then
    echo "vorta-require-repo: missing repository host" >&2
    exit 1
fi

if timeout 5 bash -c "exec 3<>/dev/tcp/${host}/${port}" 2>/dev/null; then
    exit 0
fi

echo "Backup skipped: ${host}:${port} not reachable" >&2
exit 1
